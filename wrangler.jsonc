{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "genevieve-emergency-v103",
  "main": "./src/worker.js",
  "compatibility_date": "2026-08-27",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  }
}
